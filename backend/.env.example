# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ─── Authentication ──────────────────────────────────────────────────────────
JWT_SECRET="replace-with-generated-secret"

# ─── CORS ────────────────────────────────────────────────────────────────────
# Allowed origin for CORS requests (comma-separated for multiple)
# Used at src/index.js:39 — fallback: "*" (all origins)
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
HOST="0.0.0.0"
NODE_ENV=production

# ─── WebAuthn / Passkey (FIDO2) ──────────────────────────────────────────────
# RP_ID must match the domain serving the frontend (no protocol, no port for production)
# ORIGIN must match the exact frontend URL including protocol and port
WEBAUTHN_ENABLED=true
WEBAUTHN_RP_NAME="Lodgist"
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:3000"

# ─── WhatsApp Cloud API ──────────────────────────────────────────────────────
WHATSAPP_API_TOKEN="your_whatsapp_api_token"
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"
WHATSAPP_VERIFY_TOKEN="replace-with-verify-token"
WHATSAPP_APP_SECRET="your_whatsapp_app_secret"
WHATSAPP_PUBLIC_URL="http://localhost:4000"

# ─── AI / Fraud Detection ────────────────────────────────────────────────────
OPENAI_API_KEY="sk-your-openai-key"
GEMINI_API_KEY="your-gemini-api-key"

# ─── Paystack ────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY="sk_live_your_paystack_secret"
PAYSTACK_PUBLIC_KEY="pk_live_your_paystack_public"
