# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@shadowspark-spine.cgdee2822czx.us-east-1.rds.amazonaws.com:5432/postgres"

# ─── Authentication ──────────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"

# ─── CORS ────────────────────────────────────────────────────────────────────
# Allowed origin for CORS requests (comma-separated for multiple)
# Used at src/index.js:39 — fallback: "*" (all origins)
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
HOST="0.0.0.0"
NODE_ENV=production

# ─── WebAuthn / Passkey (FIDO2) ──────────────────────────────────────────────
# RP_ID must match the domain serving the frontend (no protocol, no port for production)
# ORIGIN must match the exact frontend URL including protocol and port
WEBAUTHN_ENABLED=true
WEBAUTHN_RP_NAME="Lodgist"
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:3000"

# ─── WhatsApp Cloud API (Meta) ───────────────────────────────────────────────
# Authoritative webhook: GET/POST /api/whatsapp/webhook on this Express app.
# Set these names in the host. Do not commit values.
# WHATSAPP_API_TOKEN
# WHATSAPP_PHONE_NUMBER_ID
# WHATSAPP_VERIFY_TOKEN
# WHATSAPP_APP_SECRET
# WHATSAPP_PUBLIC_URL   public site origin used in replies (no trailing slash)
# PUBLIC_APP_URL        same origin for Rental Safety Check payment return links

# ─── Paystack ────────────────────────────────────────────────────────────────
# PAYSTACK_SECRET_KEY is required before a Rental Safety Check can be paid.
# Do not commit a value. PAYSTACK_PUBLIC_KEY is not read by the check flow.

# ─── AI / Fraud Detection ────────────────────────────────────────────────────
OPENAI_API_KEY="sk-your-openai-key"
GEMINI_API_KEY="your-gemini-api-key"

# ─── Paystack ────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY="sk_live_your_paystack_secret"
PAYSTACK_PUBLIC_KEY="pk_live_your_paystack_public"
