{
  "buildCommand": "pnpm install && pnpm --filter=frontend build",
  "outputDirectory": "apps/lodgist/.next",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "nextjs"
    },
    "backend": {
      "entrypoint": "backend",
      "routePrefix": "/_/backend"
    }
  }
}
