# docs/contracts/lodgist-api.env.template
# Railway API service — lodgist project
# Values marked <ROTATE> must be minted fresh. Never reuse a Drive-recovered value.
# Never commit a filled copy of this file.

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=production
HOST=0.0.0.0
PORT=                      # leave empty — Railway injects its own

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=<ROTATE>        # openssl rand -base64 32

# ── Network / CORS ───────────────────────────────────────────
CORS_ORIGIN=https://lodgist.online

# ── WebAuthn ─────────────────────────────────────────────────
WEBAUTHN_RP_ID=lodgist.online
WEBAUTHN_ORIGIN=https://lodgist.online

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=<ROTATE>      # Neon connection string — do not flip existing (I03)
