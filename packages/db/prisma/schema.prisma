generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  USER
  ARTISAN
  LANDLORD
  STUDIO_ADMIN
  TENANT
  AGENT
}

enum ListingCategory {
  RESIDENTIAL
  COMMERCIAL
  SHORT_LET
}

enum ListingStatus {
  PENDING
  VERIFIED
  REJECTED
  ARCHIVED
}

// Public-review decision only. APPROVED means Lodgist approved the home for
// public display. It is not evidence that verification checks are complete,
// and payment must not set it.
enum ListingReviewStatus {
  NOT_REVIEWED
  APPROVED
}

enum BookingStatus {
  PENDING
  PENDING_VERIFICATION
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ViewingStatus {
  REQUESTED
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
  DISPUTED
}

enum NotificationType {
  BOOKING_CONFIRMATION
  VIEWING_REMINDER
  PAYMENT_RECEIPT
  FRAUD_ALERT
  TRUTH_SCORE_UPDATE
  MESSAGE_RECEIVED
  ESCROW_UPDATE
}

enum Currency {
  NGN
  USD
  GBP
  EUR
}

// ── Models ─────────────────────────────────────────────────────────────────

model User {
  id              Int                  @id @default(autoincrement())
  name            String
  email           String               @unique
  passwordHash    String?
  phone           String?
  whatsappId      String?              @unique
  role            Role                 @default(USER)
  truthIndex      Float                @default(0.0)
  isVerified      Boolean              @default(false)
  isHNW           Boolean              @default(false)
  hnwVerifiedAt   DateTime?
  avatarUrl       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  // Relations
  passkeys          PasskeyCredential[]
  passkeyChallenges PasskeyChallenge[]
  listings          Listing[]
  bookings          Booking[]              @relation("TenantBookings")
  verifiedBookings  Booking[]              @relation("VerifierBookings")
  viewingRequests   ViewingRequest[]
  reviews           Review[]
  fraudReports      FraudReport[]          @relation("ReporterFraudReports")
  reportedFraud     FraudReport[]          @relation("ReportedFraudReports")
  truthScores       TruthIndexScore[]
  whatsappSessions  WhatsAppSession[]      @relation("UserWhatsappSessions")
  contactSessions   WhatsAppSession[]      @relation("ContactWhatsappSessions")
  notifications     Notification[]
  sentMessages      WhatsAppMessage[]      @relation("SenderMessages")
  escrowTransactions  EscrowTransaction[]  @relation("TenantEscrowTransactions")
  landlordEscrows   EscrowTransaction[]    @relation("LandlordEscrowTransactions")
  ownedProperties   Property[]
  profile           Profile?
  referrals         Referral[]
  accounts                Account[]
  sessions                Session[]
  verificationSubmissions VerificationRequest[] @relation("VerificationSubmissions")
  verificationReviews     VerificationRequest[] @relation("VerificationReviews")
  fraudSignalReports      FraudSignal[]         @relation("FraudReports")
  fraudSignalResolutions  FraudSignal[]         @relation("FraudResolutions")
  adminActions            AdminAction[]         @relation("AdminActions")
  rentalChecks            RentalCheck[]         @relation("RentalCheckCustomer")
  reviewedRentalChecks    RentalCheck[]         @relation("RentalCheckReviewer")

  @@index([email])
  @@index([whatsappId])
  @@index([role])
}

model Profile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio         String?
  state       String?
  lga         String?  // Local Government Area
  address     String?
  idType      String?  // e.g., "NIN", "BVN", "International Passport", "Driver's License"
  idNumber    String?
  idVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([state, lga])
}

model Property {
  id          Int       @id @default(autoincrement())
  ownerId     Int
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  address     String
  city        String
  state       String
  lga         String?   // Local Government Area
  landmark    String?
  latitude    Float?
  longitude   Float?
  propertyType String?  // "Apartment", "House", "Duplex", "Shop", "Office", "Land"
  bedrooms    Int?
  bathrooms   Int?
  size        Float?    // Square meters
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  listings    Listing[]

  @@index([state, lga])
  @@index([ownerId])
}

model Listing {
  id              Int              @id @default(autoincrement())
  propertyId      Int?
  property        Property?        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ownerId         Int
  owner           User             @relation(fields: [ownerId], references: [id])
  title           String
  description     String
  price           Float
  currency        Currency         @default(NGN)
  category        ListingCategory  @default(RESIDENTIAL)
  status          ListingStatus    @default(PENDING)
  isFeatured      Boolean          @default(false)
  views           Int              @default(0)
  isFlaggedForFraud Boolean         @default(false)
  fraudReason       String?
  // Nullable so public browse can match unscored rows (IS NULL) or VERIFIED.
  // A required enum makes Prisma 7.8 throw PrismaClientValidationError
  // ("Argument `riskState` is missing") for `{ riskState: null }`.
  riskState         RiskState?      @default(UNVERIFIED)
  truthIndex        Int?
  reviewStatus      ListingReviewStatus @default(NOT_REVIEWED)
  // Evidence review, separate from reviewStatus (publish) and status VERIFIED
  // (viewing gate). Null or false is not "Verified by Lodgist".
  // verifiedById is the acting user id. It stays a nullable audit column with
  // no foreign key, including after AdminAction exists.
  evidenceVerified  Boolean?
  verifiedAt        DateTime?
  verifiedById      Int?
  rejectionReason   String?
  adminAudit        Json?

  // Nigerian real estate metadata
  totalMoveInCost Json?            // { base_rent, agency_fee, legal_fee, caution_fee, inspection_fee?, currency, total }
  availableFrom   DateTime?
  furnished       Boolean?
  serviceCharge   Float?           // Annual service/maintenance charge in NGN

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  images            ListingImage[]
  bookings          Booking[]
  viewingRequests   ViewingRequest[]
  fraudSignals      AIFraudSignal[]
  reviews           Review[]
  escrowTransactions EscrowTransaction[]
  fraudReports         FraudReport[]
  whatsappSessions     WhatsAppSession[]
  verificationRequests VerificationRequest[]
  trustSignals         FraudSignal[]
  trustComponents      TrustComponent[]

  @@index([ownerId])
  @@index([category])
  @@index([status])
}

model ListingImage {
  id        Int      @id @default(autoincrement())
  listingId Int
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([listingId])
}

model Booking {
  id          String       @id @default(cuid())
  listingId   Int
  listing     Listing      @relation(fields: [listingId], references: [id])
  tenantId    Int
  tenant      User         @relation("TenantBookings", fields: [tenantId], references: [id])
  startDate   DateTime
  endDate     DateTime
  status           BookingStatus @default(PENDING)
  manualPaymentRef String?
  paystackReference String?     @unique
  verifiedBy       Int?
  verifier         User?         @relation("VerifierBookings", fields: [verifiedBy], references: [id], onDelete: SetNull)
  verifiedAt       DateTime?
  totalAmount      Float
  currency         Currency      @default(NGN)
  notes            String?
  sourceChannel    String?       // lead origin: whatsapp | instagram | chatbot | direct | referral
  adminNotes       String?       // internal staff notes — not visible to tenant
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tenantId])
  @@index([listingId])
  @@index([status])
  // Present since 20260518000000. Declared here so migrate diff does not drop it.
  @@index([verifiedBy])
}

model ViewingRequest {
  id          Int           @id @default(autoincrement())
  listingId   Int
  listing     Listing       @relation(fields: [listingId], references: [id])
  requesterId Int
  requester   User          @relation(fields: [requesterId], references: [id])
  preferredDate DateTime
  preferredTime String?
  status      ViewingStatus @default(REQUESTED)
  notes       String?
  scheduledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([listingId])
  @@index([requesterId])
  @@index([status])
}

model Review {
  id        Int      @id @default(autoincrement())
  listingId Int
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  rating    Int      // 1-5
  comment   String?
  createdAt DateTime @default(now())

  @@index([listingId])
  @@index([userId])
}

model EscrowTransaction {
  id          String        @id @default(cuid())
  reference   String        @unique
  tenantId    Int
  tenant      User          @relation("TenantEscrowTransactions", fields: [tenantId], references: [id])
  landlordId  Int
  landlord    User          @relation("LandlordEscrowTransactions", fields: [landlordId], references: [id])
  listingId   Int?
  listing     Listing?      @relation(fields: [listingId], references: [id])
  amount      Float
  currency    Currency      @default(NGN)
  status      EscrowStatus  @default(HELD)
  description String?
  releaseDate             DateTime?
  paystackAuthorizationUrl  String?
  paystackReference       String?
  commissionAmount        Float         @default(0)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([reference])
  @@index([tenantId])
  @@index([landlordId])
  @@index([status])
}

model FraudReport {
  id          Int      @id @default(autoincrement())
  listingId   Int?
  listing     Listing? @relation(fields: [listingId], references: [id])
  reporterId  Int
  reporter    User     @relation("ReporterFraudReports", fields: [reporterId], references: [id])
  reportedId  Int
  reported    User     @relation("ReportedFraudReports", fields: [reportedId], references: [id])
  description String
  evidence    Json?    // Array of evidence URLs or descriptions
  status      String   @default("PENDING") // PENDING, INVESTIGATING, CONFIRMED, DISMISSED
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([reporterId])
  @@index([reportedId])
  @@index([status])
}

model AIFraudSignal {
  id          Int      @id @default(autoincrement())
  listingId   Int
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  score       Float
  reasoning   String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([listingId])
  @@index([score])
}

model TruthIndexScore {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score       Float
  activityScore   Float?
  verificationScore Float?
  ratingScore     Float?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model WhatsAppSession {
  id          String           @id @default(cuid())
  // Null for unknown WhatsApp senders. Leads are stored on `phone` until they
  // have a User row. Do not invent a User to satisfy this relation.
  userId      Int?
  // ON DELETE RESTRICT matches the baseline FK. The column was made nullable
  // later; the constraint was not recreated, and this PR does not drop it.
  user        User?            @relation("UserWhatsappSessions", fields: [userId], references: [id], onDelete: Restrict)
  contactId   Int?
  contact     User?            @relation("ContactWhatsappSessions", fields: [contactId], references: [id], onDelete: Restrict)
  phone       String?
  listingId   Int?
  listing     Listing?         @relation(fields: [listingId], references: [id])
  contactName String?
  platform    String           @default("whatsapp")
  isActive    Boolean          @default(true)
  handoffRequested Boolean     @default(false)
  messages    WhatsAppMessage[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@index([contactId])
  @@index([listingId])
  @@index([phone])
}

model WhatsAppMessage {
  id        Int              @id @default(autoincrement())
  sessionId String
  session   WhatsAppSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  senderId  Int?
  // Same as WhatsAppSession user/contact: nullable column, existing RESTRICT FK.
  sender    User?            @relation("SenderMessages", fields: [senderId], references: [id], onDelete: Restrict)
  content   String
  messageType String         @default("TEXT") // TEXT, IMAGE, DOCUMENT, LOCATION
  direction   String         @default("INBOUND") // INBOUND, OUTBOUND
  metadata  Json?
  sentAt    DateTime         @default(now())
  deliveredAt DateTime?
  readAt    DateTime?

  @@index([sessionId])
  @@index([senderId])
}

model Referral {
  id            Int      @id @default(autoincrement())
  referrerId    Int      @unique
  referrer      User     @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  count         Int      @default(0)
  rewardClaimed Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([referrerId])
}

model PasskeyCredential {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // FIDO2 WebAuthn fields
  credentialId  String  @unique // Base64URL-encoded raw ID
  publicKey     Bytes            // COSE-encoded public key
  counter       Int     @default(0) // Signature counter for replay detection
  transports    String?          // JSON array: ["usb","nfc","ble","internal"]
  backedUp      Boolean @default(false)
  deviceType    String  @default("platform") // "platform" (TouchID/Windows Hello) or "cross-platform" (security key)

  // Metadata
  name        String   @default("Passkey")
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())

  @@index([userId])
  @@index([credentialId])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?            // Additional payload
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

// ── NextAuth Models ───────────────────────────────────────────────────────
// Required by @auth/prisma-adapter for OAuth + Email provider flows.
// userId references User.id (Int) to match packages/db's schema.

model Account {
  id                String  @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Webhook Idempotency ───────────────────────────────────────────────────────
// Stores processed Paystack webhook event IDs to prevent duplicate processing
// across restarts and horizontal scaling. The primary key uniqueness constraint
// is the idempotency lock — concurrent duplicates hit P2002 and short-circuit.

model ProcessedWebhookEvent {
  id        String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ── Passkey Challenge Store ───────────────────────────────────────────────────
// Short-lived server-side challenge storage for WebAuthn ceremonies.
// Prevents replay attacks by ensuring the challenge was issued by this server.
// userId is nullable to support discoverable (usernameless) login flows.

model PasskeyChallenge {
  id        String    @id @default(cuid())
  userId    Int?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([challenge])
  @@index([expiresAt])
}

// ── Trust Layer Enums ──────────────────────────────────────────────────────

enum RiskState {
  VERIFIED
  UNVERIFIED
  UNDER_REVIEW
  FLAGGED
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  NEEDS_MORE_INFO
}

enum FraudSignalType {
  DUPLICATE_LISTING
  FAKE_DOCUMENT
  PRICE_MANIPULATION
  IDENTITY_MISMATCH
  SUSPICIOUS_ACTIVITY
  USER_REPORT
  AGENT_REPORT
}

enum SignalSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SignalSource {
  SYSTEM
  USER_REPORT
  ADMIN_MANUAL
  AGENT_REPORT
}

enum SignalStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum AdminActionType {
  RISK_STATE_OVERRIDE
  FRAUD_SIGNAL_CREATED
  FRAUD_SIGNAL_RESOLVED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
}

// ── Trust Layer Models ─────────────────────────────────────────────────────

model VerificationRequest {
  id            String             @id @default(cuid())
  listingId     Int
  listing       Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  submittedById Int
  submittedBy   User               @relation("VerificationSubmissions", fields: [submittedById], references: [id])
  status        VerificationStatus @default(PENDING)
  documentUrls  String[]
  notes         String?
  reviewNote    String?
  reviewedById  Int?
  reviewedBy    User?              @relation("VerificationReviews", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([listingId])
  @@index([status])
  @@index([submittedById])
}

model FraudSignal {
  id           String          @id @default(cuid())
  listingId    Int
  listing      Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  signalType   FraudSignalType
  severity     SignalSeverity  @default(MEDIUM)
  source       SignalSource
  description  String
  status       SignalStatus    @default(OPEN)
  reportedById Int?
  reportedBy   User?           @relation("FraudReports", fields: [reportedById], references: [id])
  resolvedById Int?
  resolvedBy   User?           @relation("FraudResolutions", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?
  metadata     Json?
  createdAt    DateTime        @default(now())

  @@index([listingId])
  @@index([status])
  @@index([severity])
}

model TrustComponent {
  id           String    @id @default(cuid())
  listingId    Int
  listing      Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  componentKey String
  label        String
  passed       Boolean   @default(false)
  weight       Int
  notes        String?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([listingId, componentKey])
  @@index([listingId])
}

model AdminAction {
  id              String          @id @default(cuid())
  adminId         Int
  admin           User            @relation("AdminActions", fields: [adminId], references: [id])
  actionType      AdminActionType
  targetListingId Int?
  targetUserId    Int?
  payload         Json
  createdAt       DateTime        @default(now())

  @@index([adminId])
  @@index([targetListingId])
}

// Anonymous demand when browse/search has no verified match.
// This does not create a listing and does not change Listing.status.
model Lead {
  id              Int      @id @default(autoincrement())
  location        String
  budget          Float
  bedrooms        Int
  moveInTimeframe String
  phone           String
  email           String?
  createdAt       DateTime @default(now())

  @@index([phone])
  @@index([createdAt])
}

// Who may list the home. A claim on this lead is not a reviewed listing.
enum AdvertiserAuthority {
  CONTROLS
  AUTHORIZED
}

// Current availability stated by the advertiser. Not a published listing.
enum AdvertiserAvailability {
  AVAILABLE_NOW
  FROM_DATE
  NOT_AVAILABLE
}

enum AdvertiserRentPeriod {
  MONTH
  YEAR
  SEMESTER
}

// Landlord/hostel interest for paid presentation + enquiry management.
// Payment / this lead never changes Listing.status or verification.
// Nullable publish-fact columns are for rows saved before the packet existed.
// New intake must set them. Null does not publish a home.
model AdvertiserLead {
  id                      Int                      @id @default(autoincrement())
  name                    String
  phone                   String
  area                    String
  propertyCount           Int?
  notes                   String?
  email                   String?
  authority               AdvertiserAuthority?
  photoPublicationAllowed Boolean?
  availability            AdvertiserAvailability?
  availableFrom           DateTime?
  rentPeriod              AdvertiserRentPeriod?
  // { baseRent, agency, legal, caution, inspection } each { known: false } or { known: true, amountNgn }
  moveInFees              Json?
  createdAt               DateTime                 @default(now())

  @@index([phone])
  @@index([createdAt])
}

// Paid Rental Safety Check. A paid case is a review, not verification.
// paymentDetails may hold bank-account evidence. It must not hold card, PIN, or OTP secrets.
enum RentalCheckStatus {
  SUBMITTED
  AWAITING_PAYMENT
  PAID
  UNDER_REVIEW
  REPORT_READY
  DELIVERED
  CANCELLED
}

enum RentalCheckPaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
}

enum RentalCheckReviewStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
}

enum RentalCheckConfidence {
  LOW
  MEDIUM
  HIGH
}

enum RentalCheckRecommendation {
  LOWER_RISK
  UNCERTAIN
  HIGH_RISK
}

model RentalCheck {
  id                String                     @id @default(cuid())
  publicReference   String                     @unique
  accessTokenHash   String
  userId            Int?
  user              User?                      @relation("RentalCheckCustomer", fields: [userId], references: [id])
  customerName      String?
  customerPhone     String
  customerEmail     String?
  listingUrl        String?
  location          String
  askingRent        Int
  agentName         String?
  agentPhone        String?
  paymentDetails    Json?
  customerNotes     String?
  status            RentalCheckStatus          @default(SUBMITTED)
  paymentStatus     RentalCheckPaymentStatus   @default(UNPAID)
  reviewStatus      RentalCheckReviewStatus    @default(NOT_STARTED)
  paystackReference String?                    @unique
  amountNgn         Int                        @default(5000)
  // Transfer reference for the check fee. Not rent, not a deposit, and not a receipt until staff confirm it.
  manualPaymentRef  String?
  paymentSubmittedAt DateTime?
  paymentReviewedBy Int?
  paymentReviewedAt DateTime?
  paymentReviewNote String?
  paidAt            DateTime?
  riskScore         Int?
  confidence        RentalCheckConfidence?
  recommendation    RentalCheckRecommendation?
  reviewerNotes     String?
  evidence          Json?
  reviewedBy        Int?
  reviewer          User?                      @relation("RentalCheckReviewer", fields: [reviewedBy], references: [id])
  reviewedAt        DateTime?
  reportPublishedAt DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime                   @default(now())
  // DB default matches 20261005123000. @updatedAt still overwrites it on writes.
  updatedAt         DateTime                   @default(now()) @updatedAt

  @@index([customerPhone])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

// In-progress WhatsApp CHECK collection. Not a case until the fields are complete.
model RentalCheckDraft {
  id        String   @id @default(cuid())
  phone     String   @unique
  step      String
  fields    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Spatial monitoring. New tables only. listingId stays inside `target` JSON
// so Listing is not altered. Observations are evidence envelopes, not alerts.
model SpatialMonitor {
  id                String                       @id
  targetType        String
  target            Json
  providers         Json
  observationType   String
  baseline          Json?
  conditions        Json
  schedule          Json
  lastObservedAt    DateTime?
  state             String
  provenance        Json?
  privacy           String                       @default("APPROXIMATE")
  monitoringBeganAt DateTime
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  observations      SpatialMonitorObservation[]
  snapshots         SpatialReportSnapshot[]
  anomalies         SpatialAnomaly[]

  @@index([targetType])
  @@index([state])
}

model SpatialMonitorObservation {
  id             String         @id
  monitorId      String
  monitor        SpatialMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  envelope       Json
  freshness      String
  classification String
  observedAt     DateTime?
  retrievedAt    DateTime?
  createdAt      DateTime       @default(now())

  @@index([monitorId])
  @@index([observedAt])
}

// Report snapshots captured at or after monitoringBeganAt. New table only.
// The foreign key lives here, so SpatialMonitor and Listing are not altered.
model SpatialReportSnapshot {
  id         String         @id
  monitorId  String
  monitor    SpatialMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  capturedAt DateTime
  report     Json
  privacy    String         @default("APPROXIMATE")
  provenance Json?
  createdAt  DateTime       @default(now())

  @@index([monitorId])
  @@index([capturedAt])
}

// Anomaly decisions. New table only. The foreign key lives here, so
// SpatialMonitor, Listing, and earlier tables are not altered.
// explanation is optional text and is not an input to severity or confidence.
model SpatialAnomaly {
  id              String         @id
  monitorId       String
  monitor         SpatialMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  family          String
  severity        String
  confidence      Float
  reason          String
  observationIds  Json
  rule            Json
  provider        String?
  triggeredAt     DateTime
  evidence        Json
  explanation     String?
  provenance      Json?
  createdAt       DateTime       @default(now())

  @@index([monitorId])
  @@index([family])
  @@index([triggeredAt])
}
