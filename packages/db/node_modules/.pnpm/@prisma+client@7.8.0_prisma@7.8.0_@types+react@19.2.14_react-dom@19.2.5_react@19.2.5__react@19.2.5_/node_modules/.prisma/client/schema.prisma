generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  USER
  ARTISAN
  LANDLORD
  STUDIO_ADMIN
}

enum ListingCategory {
  RESIDENTIAL
  COMMERCIAL
  SHORT_LET
}

enum ListingStatus {
  PENDING
  VERIFIED
  REJECTED
  ARCHIVED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ViewingStatus {
  REQUESTED
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
  DISPUTED
}

enum NotificationType {
  BOOKING_CONFIRMATION
  VIEWING_REMINDER
  PAYMENT_RECEIPT
  FRAUD_ALERT
  TRUTH_SCORE_UPDATE
  MESSAGE_RECEIVED
  ESCROW_UPDATE
}

enum Currency {
  NGN
  USD
  GBP
  EUR
}

// ── Models ─────────────────────────────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String?
  phone        String?
  whatsappId   String?  @unique
  role         Role     @default(USER)
  truthIndex   Float    @default(0.0)
  isVerified   Boolean  @default(false)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  listings           Listing[]
  bookings           Booking[]           @relation("TenantBookings")
  viewingRequests    ViewingRequest[]
  reviews            Review[]
  fraudReports       FraudReport[]       @relation("ReporterFraudReports")
  reportedFraud      FraudReport[]       @relation("ReportedFraudReports")
  truthScores        TruthIndexScore[]
  whatsappSessions   WhatsAppSession[]   @relation("UserWhatsappSessions")
  contactSessions    WhatsAppSession[]   @relation("ContactWhatsappSessions")
  notifications      Notification[]
  sentMessages       WhatsAppMessage[]   @relation("SenderMessages")
  escrowTransactions EscrowTransaction[] @relation("TenantEscrowTransactions")
  landlordEscrows    EscrowTransaction[] @relation("LandlordEscrowTransactions")
  ownedProperties    Property[]
  profile            Profile?
  referrals          Referral[]

  @@index([email])
  @@index([whatsappId])
  @@index([role])
}

model Profile {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio        String?
  state      String?
  lga        String? // Local Government Area
  address    String?
  idType     String? // e.g., "NIN", "BVN", "International Passport", "Driver's License"
  idNumber   String?
  idVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([state, lga])
}

model Property {
  id           Int      @id @default(autoincrement())
  ownerId      Int
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  address      String
  city         String
  state        String
  lga          String? // Local Government Area
  landmark     String?
  latitude     Float?
  longitude    Float?
  propertyType String? // "Apartment", "House", "Duplex", "Shop", "Office", "Land"
  bedrooms     Int?
  bathrooms    Int?
  size         Float? // Square meters
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  listings Listing[]

  @@index([state, lga])
  @@index([ownerId])
}

model Listing {
  id                Int             @id @default(autoincrement())
  propertyId        Int?
  property          Property?       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ownerId           Int
  owner             User            @relation(fields: [ownerId], references: [id])
  title             String
  description       String
  price             Float
  currency          Currency        @default(NGN)
  category          ListingCategory @default(RESIDENTIAL)
  status            ListingStatus   @default(PENDING)
  isFeatured        Boolean         @default(false)
  views             Int             @default(0)
  isFlaggedForFraud Boolean         @default(false)
  fraudReason       String?

  // Nigerian real estate metadata
  totalMoveInCost Json? // { base_rent, agency_fee, legal_fee, caution_fee, inspection_fee?, currency, total }
  availableFrom   DateTime?
  furnished       Boolean?
  serviceCharge   Float? // Annual service/maintenance charge in NGN

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  images             ListingImage[]
  bookings           Booking[]
  viewingRequests    ViewingRequest[]
  fraudSignals       AIFraudSignal[]
  reviews            Review[]
  escrowTransactions EscrowTransaction[]
  fraudReports       FraudReport[]
  whatsappSessions   WhatsAppSession[]

  @@index([ownerId])
  @@index([category])
  @@index([status])
}

model ListingImage {
  id        Int      @id @default(autoincrement())
  listingId Int
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([listingId])
}

model Booking {
  id          String        @id @default(cuid())
  listingId   Int
  listing     Listing       @relation(fields: [listingId], references: [id])
  tenantId    Int
  tenant      User          @relation("TenantBookings", fields: [tenantId], references: [id])
  startDate   DateTime
  endDate     DateTime
  status      BookingStatus @default(PENDING)
  totalAmount Float
  currency    Currency      @default(NGN)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([tenantId])
  @@index([listingId])
  @@index([status])
}

model ViewingRequest {
  id            Int           @id @default(autoincrement())
  listingId     Int
  listing       Listing       @relation(fields: [listingId], references: [id])
  requesterId   Int
  requester     User          @relation(fields: [requesterId], references: [id])
  preferredDate DateTime
  preferredTime String?
  status        ViewingStatus @default(REQUESTED)
  notes         String?
  scheduledAt   DateTime?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([listingId])
  @@index([requesterId])
  @@index([status])
}

model Review {
  id        Int      @id @default(autoincrement())
  listingId Int
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  @@index([listingId])
  @@index([userId])
}

model EscrowTransaction {
  id                       String       @id @default(cuid())
  reference                String       @unique
  tenantId                 Int
  tenant                   User         @relation("TenantEscrowTransactions", fields: [tenantId], references: [id])
  landlordId               Int
  landlord                 User         @relation("LandlordEscrowTransactions", fields: [landlordId], references: [id])
  listingId                Int?
  listing                  Listing?     @relation(fields: [listingId], references: [id])
  amount                   Float
  currency                 Currency     @default(NGN)
  status                   EscrowStatus @default(HELD)
  description              String?
  releaseDate              DateTime?
  paystackAuthorizationUrl String?
  paystackReference        String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  @@index([reference])
  @@index([tenantId])
  @@index([landlordId])
  @@index([status])
}

model FraudReport {
  id          Int       @id @default(autoincrement())
  listingId   Int?
  listing     Listing?  @relation(fields: [listingId], references: [id])
  reporterId  Int
  reporter    User      @relation("ReporterFraudReports", fields: [reporterId], references: [id])
  reportedId  Int
  reported    User      @relation("ReportedFraudReports", fields: [reportedId], references: [id])
  description String
  evidence    Json? // Array of evidence URLs or descriptions
  status      String    @default("PENDING") // PENDING, INVESTIGATING, CONFIRMED, DISMISSED
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([reporterId])
  @@index([reportedId])
  @@index([status])
}

model AIFraudSignal {
  id        Int      @id @default(autoincrement())
  listingId Int
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  score     Float
  reasoning String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([listingId])
  @@index([score])
}

model TruthIndexScore {
  id                Int      @id @default(autoincrement())
  userId            Int
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score             Float
  activityScore     Float?
  verificationScore Float?
  ratingScore       Float?
  metadata          Json?
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model WhatsAppSession {
  id        String            @id @default(cuid())
  userId    Int
  user      User              @relation("UserWhatsappSessions", fields: [userId], references: [id])
  contactId Int
  contact   User              @relation("ContactWhatsappSessions", fields: [contactId], references: [id])
  listingId Int?
  listing   Listing?          @relation(fields: [listingId], references: [id])
  isActive  Boolean           @default(true)
  messages  WhatsAppMessage[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId])
  @@index([contactId])
  @@index([listingId])
}

model WhatsAppMessage {
  id          Int             @id @default(autoincrement())
  sessionId   String
  session     WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  senderId    Int
  sender      User            @relation("SenderMessages", fields: [senderId], references: [id])
  content     String
  messageType String          @default("TEXT") // TEXT, IMAGE, DOCUMENT, LOCATION
  metadata    Json?
  sentAt      DateTime        @default(now())
  deliveredAt DateTime?
  readAt      DateTime?

  @@index([sessionId])
  @@index([senderId])
}

model Referral {
  id            Int      @id @default(autoincrement())
  referrerId    Int      @unique
  referrer      User     @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  count         Int      @default(0)
  rewardClaimed Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([referrerId])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json? // Additional payload
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}
