# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Prisma adapter)
# Runtime: Neon pooled URL. Migrations: Neon direct URL in DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Direct PostgreSQL connection string (migrations and seed)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ── Google Cloud ──────────────────────────────────────────────────────────────
# Path to Google Application Credentials JSON file. Do not commit the file.
GOOGLE_APPLICATION_CREDENTIALS="./lodgist-key.json"
