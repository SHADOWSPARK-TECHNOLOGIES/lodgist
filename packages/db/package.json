{
  "name": "@lodgist/db",
  "version": "1.0.0",
  "private": true,
  "main": "src/client.js",
  "scripts": {
    "generate": "npx prisma generate --config prisma.config.ts",
    "db:push": "npx prisma db push --config prisma.config.ts",
    "db:migrate": "npx prisma migrate dev --config prisma.config.ts",
    "db:studio": "npx prisma studio --config prisma.config.ts",
    "db:seed": "node prisma/seed-owerri-home.js",
    "test": "node --test prisma/seed-owerri-home.test.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "prisma": "^7.8.0",
    "tsx": "^4.7.0"
  },
  "prisma": {
    "seed": "node prisma/seed-owerri-home.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
