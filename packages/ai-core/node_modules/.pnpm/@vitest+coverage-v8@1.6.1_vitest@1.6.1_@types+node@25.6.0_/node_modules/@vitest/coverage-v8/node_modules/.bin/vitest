#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/workspace/packages/ai-core/node_modules/.pnpm/vitest@1.6.1_@types+node@25.6.0/node_modules/vitest/node_modules:/workspace/packages/ai-core/node_modules/.pnpm/vitest@1.6.1_@types+node@25.6.0/node_modules:/workspace/packages/ai-core/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/workspace/packages/ai-core/node_modules/.pnpm/vitest@1.6.1_@types+node@25.6.0/node_modules/vitest/node_modules:/workspace/packages/ai-core/node_modules/.pnpm/vitest@1.6.1_@types+node@25.6.0/node_modules:/workspace/packages/ai-core/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../../../../vitest@1.6.1_@types+node@25.6.0/node_modules/vitest/vitest.mjs" "$@"
else
  exec node  "$basedir/../../../../../../vitest@1.6.1_@types+node@25.6.0/node_modules/vitest/vitest.mjs" "$@"
fi
